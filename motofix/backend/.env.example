# Variables de entorno opcionales (el sistema funciona sin ninguna en modo demo)
PORT=4000
# Producción: desactiva el selector de rol simulado y la carga de datos de ejemplo
DEMO_MODE=false
AUTO_SEED=false
# Secreto de firma de sesiones (JWT). Genera uno largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Duración de sesión en segundos (8 h por defecto)
TOKEN_TTL=28800
# true si hay un proxy inverso (nginx, Caddy…) delante: toma la IP real de X-Forwarded-For
TRUST_PROXY=true
# Ubicación de la base de datos SQLite
# DB_PATH=/var/lib/motofix/motofix.db

# ---- Base en la nube (obligatorio en Vercel) ----
# Con estas dos variables la base vive en Turso en lugar del archivo local.
# TURSO_DATABASE_URL=libsql://motofix-<usuario>.turso.io
# TURSO_AUTH_TOKEN=
# Protege /api/setup (carga inicial de la demo) y /api/cron/tick (cron diario de Vercel)
# CRON_SECRET=

# ---- Cuentas por pagar: lectura de PDF con un proveedor de IA gratuito ----
# Sin AI_API_KEY la extracción de PDF queda simulada y el sistema lo indica.
# La clave NUNCA va en el código ni en la base de datos. Verifica los límites gratuitos del proveedor antes de usarlo.
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-flash-latest  (alias que sigue al Flash vigente)
