{
  "name": "motofix-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de MotoFix: facturación, inventario, RBAC, auditoría inmutable y Auditor Inteligente de anomalías (sin dependencias externas)",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "turso:init": "node --disable-warning=ExperimentalWarning src/tools/turso-init.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
